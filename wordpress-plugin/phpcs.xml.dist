<?xml version="1.0"?>
<ruleset name="wp-mobile-client">
	<description>WordPress Coding Standards for the WP Mobile Client plugin.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg value="s"/>
	<arg name="extensions" value="php"/>

	<config name="minimum_supported_wp_version" value="6.2"/>
	<config name="text_domain" value="wp-mobile-client"/>

	<rule ref="WordPress"/>
</ruleset>
